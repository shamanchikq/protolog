<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower Auto Backup rules (audit D3). See the comment on <application> in
     AndroidManifest.xml. allowBackup="false" already turns backup off on these versions; this
     excludes every domain as well, so nothing is backed up even if that attribute changes. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
